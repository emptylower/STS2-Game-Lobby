STS2_NODE_IMAGE=node:20-bookworm-slim
# 敏感词过滤（首次启动的种子值；之后以管理面板设置为准）
#SENSITIVE_FILTER_ENABLED=true
# 词库目录覆盖（默认包根 lexicon/）
#SENSITIVE_LEXICON_DIR=
# Container runtime values belong in lobby-service.docker.env; these are shown
# here so copied single-file deployments do not miss the persistent AI files.
AI_MODERATION_CREDENTIAL_KEY=
AI_MODERATION_STATE_FILE=/app/data/ai-moderation-state.json
AI_MODERATION_CACHE_FILE=/app/data/ai-moderation-cache.json
AI_MODERATION_TIMEOUT_MS=5000
AI_MODERATION_MAX_CONCURRENCY=4
AI_MODERATION_MAX_QUEUE=64
AI_MODERATION_REVIEWS_PER_IP_MINUTE=10
